{
  "name": "fbs-screen-manager",
  "version": "1.1.0",
  "description": "Gerenciador local de mídia para telão e segundo monitor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/control.test.js tests/output.test.js tests/live-server.test.js",
    "package": "electron-builder --win nsis"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "com.fbs.screenmanager",
    "productName": "FBS Screen Manager",
    "files": [
      "main.js",
      "preload.js",
      "desktop/*.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/windows",
        "to": "windows-display"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
