{
  "name": "fbs-screen-manager",
  "version": "1.1.0",
  "description": "Gerenciador local de mídia para telão e segundo monitor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/control.test.js tests/output.test.js tests/live-server.test.js",
    "package": "electron-builder --win nsis",
    "package:linux": "electron-builder --linux AppImage deb",
    "package:all": "electron-builder --win nsis --linux AppImage deb"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "com.fbs.screenmanager",
    "productName": "FBS Screen Manager",
    "files": [
      "main.js",
      "preload.js",
      "desktop/*.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/ws/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "desktop/windows",
          "to": "windows-display"
        }
      ]
    },
    "linux": {
      "maintainer": "FBS Screen Manager <kinzart@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "fbs-screen-manager-${version}-${arch}.${ext}",
      "executableName": "fbs-screen-manager"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
